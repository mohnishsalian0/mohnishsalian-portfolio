---
import { Icon } from 'astro-icon/components';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <small class="footer__copy">&copy; {year} Mohnish Salian</small>
    <small class="footer__copy">mohnishsalian02@gmail.com</small>
    <ul class="footer__socials" role="list">
      <li>
        <a href="#" rel="me" aria-label="LinkedIn">
          <Icon name="simple-icons:linkedin" />
        </a>
      </li>
      <li>
        <a href="#" rel="me" aria-label="GitHub">
          <Icon name="simple-icons:github" />
        </a>
      </li>
      <li>
        <a href="#" rel="me" aria-label="Behance">
          <Icon name="simple-icons:behance" />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-16);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-6) var(--space-5);
    flex-wrap: wrap;
  }

  .footer__copy {
    color: var(--color-muted);
		font-size: var(--fs-base);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__socials li + li {
    margin-top: 0;
  }

  .footer__socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__socials a:hover {
    color: var(--color-fg);
  }

  .footer__socials svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
