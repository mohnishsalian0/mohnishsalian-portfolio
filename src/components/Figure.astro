---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  caption?: string;
  variant?: 'phone';
}

const { src, alt, caption, variant } = Astro.props;
const className = `figure${variant ? ` figure--${variant}` : ''}`;
---

<figure class={className}>
  {src ? (
    <Image src={src} alt={alt} loading="lazy" />
  ) : (
    <div class="figure-placeholder" role="img" aria-label={alt}>
      <span class="figure-placeholder__label">{alt}</span>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
