import BaseLayout from '~/layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import heroTitleSvg from '~/assets/hero-title.svg?raw';
import tieSvg from '~/assets/tie.svg?raw';
import scribbleS from '~/assets/scribble-s.svg?raw';
import goldenSeal from '~/assets/golden-seal.png';
import qrismQr from '~/assets/qrism-qr.png';
import watchparty from '~/assets/watchparty.png';
import scoot from '~/assets/scoot.png';
import hsbcDisplayBoard from '~/content/case-studies/hsbc-queue-management/images/hsbc-display-board.png';
import baleBanner from '~/content/case-studies/bale/images/banner.png';
import talbotsBanner from '~/content/case-studies/events-for-talbots/images/event-list-public.png';

const tickerWord = 'Ongoing';
const tickerItems = Array.from({ length: 12 }, () => tickerWord);
---

<BaseLayout title="Mohnish Salian" description="Designer & developer building thoughtful digital products.">
