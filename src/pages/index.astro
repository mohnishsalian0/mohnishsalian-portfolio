            </p>
            <ul class="book__tags" role="list">
              <li class="tag">🎨 UX design</li>
              <li class="tag">🛴 Micromobility</li>
              <li class="tag">🌱 Sustainability</li>
              <li class="tag">⛓️ Web3</li>
            </ul>
          </div>
        </div>
      </article>
    </div>
  </section>

  <div class="monocle" data-monocle aria-hidden="true">
    <svg class="monocle__ring" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <path
          id="monocle-ring-path"
          d="M 100 100 m -74 0 a 74 74 0 1 1 148 0 a 74 74 0 1 1 -148 0"
          fill="none"
        />
      </defs>
      <text class="monocle__text">
        <textPath
          href="#monocle-ring-path"
          startOffset="0"
          textLength="465"
          lengthAdjust="spacingAndGlyphs"
