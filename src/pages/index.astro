        >
        · CLICK TO READ&nbsp· CLICK TO READ&nbsp;
        </textPath>
      </text>
    </svg>
    <span class="monocle__icon">
      <Icon name="lucide:book-open-text" />
    </span>
  </div>

  <section class="connect">
    <h2 class="connect__heading">
      <span class="sr-only">Let&rsquo;s connect</span>
      <span aria-hidden="true"
        >Let<span class="connect__apos">&rsquo;</span>s connect</span
      >
    </h2>

    <p class="connect__desc">
			If you&rsquo;ve made it this far, we should probably just talk. You can contact me at
			<a href="#">mohnishsalian02@gmail.com</a>
    </p>

    <div class="connect__buttons">
			<a class="btn connect__btn" href="https://www.linkedin.com/in/mohnish-salian-1471a217a" target="_blank" rel="noopener noreferrer">
        <span class="connect__btn-text">
          LinkedIn <Icon name="lucide:arrow-up-right" />
        </span>
        <span class="connect__btn-brand" aria-hidden="true">
          <Icon name="simple-icons:linkedin" />
        </span>
      </a>
			<a class="btn connect__btn" href="https://github.com/mohnishsalian0" target="_blank" rel="nooperner noreferrer" aria-label="GitHub">
        <span class="connect__btn-text">
          Github <Icon name="lucide:arrow-up-right" />
        </span>
        <span class="connect__btn-brand" aria-hidden="true">
          <Icon name="simple-icons:github" />
        </span>
      </a>
        <a class="btn connect__btn" href="https://www.behance.net/mohnishsalian" target="_blank" rel="nooperner noreferrer" aria-label="Behance">
        <span class="connect__btn-text">
          Behance <Icon name="lucide:arrow-up-right" />
        </span>
        <span class="connect__btn-brand" aria-hidden="true">
          <Icon name="simple-icons:behance" />
        </span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const shelves = document.querySelectorAll<HTMLElement>('[data-shelf]');
  shelves.forEach((shelf) => {
    const books = Array.from(
      shelf.querySelectorAll<HTMLElement>('[data-book]')
    );
    if (books.length === 0) return;

    const setOpen = (i: number) => {
      books.forEach((b, bi) => b.classList.toggle('book--open', bi === i));
    };

    books.forEach((book, i) => {
      const spine = book.querySelector<HTMLButtonElement>('[data-spine]');
      spine?.addEventListener('click', () => setOpen(i));
    });
  });

  // Monocle cursor — shown on hover of case cards and closed book spines.
  const monocle = document.querySelector<HTMLElement>('[data-monocle]');
  const monocleLabel = monocle?.querySelector<SVGTextPathElement>(
    '[data-monocle-text]'
  );
  const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (monocle && monocleLabel && fineHover) {
    const setMode = (mode: 'read' | 'expand') => {
      const word = mode === 'read' ? 'READ' : 'EXPAND';
      monocleLabel.textContent = `· CLICK TO ${word} · CLICK TO ${word} `;
    };

    const ring = monocle.querySelector<SVGElement>('.monocle__ring');
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const DEFAULT_DPS = 36;   // 10s per revolution
    const BURST_DPS = 600;    // ~1.2s per revolution
    const BURST_MS = 250;
    const EASE = 0.06;        // per-frame-at-60fps lerp factor toward target

    let angle = 0;
    let speed = DEFAULT_DPS;
    let target = DEFAULT_DPS;
    let lastT = 0;
    let rafId: number | null = null;
    let stopTimer: number | undefined;
    let burstTimer: number | undefined;

    const tick = (t: number) => {
      const dt = lastT ? (t - lastT) / 1000 : 0;
      lastT = t;
      // Frame-rate independent lerp — EASE is the 60fps per-frame fraction
      const k = 1 - Math.pow(1 - EASE, dt * 60);
      speed += (target - speed) * k;
      angle = (angle + speed * dt) % 360;
      if (ring) ring.style.transform = `rotate(${angle}deg)`;
      rafId = requestAnimationFrame(tick);
    };

    const startLoop = () => {
      if (rafId != null || reducedMotion) return;
      lastT = 0;
      rafId = requestAnimationFrame(tick);
    };
    const stopLoop = () => {
      if (rafId != null) cancelAnimationFrame(rafId);
      rafId = null;
    };

    const show = () => {
      monocle.classList.add('monocle--active');
      window.clearTimeout(stopTimer);
      window.clearTimeout(burstTimer);
      target = BURST_DPS;
      burstTimer = window.setTimeout(() => {
        target = DEFAULT_DPS;
      }, BURST_MS);
      startLoop();
    };
    const hide = () => {
      monocle.classList.remove('monocle--active');
      target = DEFAULT_DPS;
      // Keep spinning through the opacity fade, then stop the loop
      window.clearTimeout(stopTimer);
      stopTimer = window.setTimeout(stopLoop, 300);
    };

    let pendingX = 0;
    let pendingY = 0;
    let posDirty = false;
    document.addEventListener(
      'mousemove',
      (e) => {
        pendingX = e.clientX;
        pendingY = e.clientY;
        if (!posDirty) {
          posDirty = true;
          requestAnimationFrame(() => {
            monocle.style.transform = `translate3d(${pendingX}px, ${pendingY}px, 0) translate(-50%, -50%)`;
            posDirty = false;
          });
        }
      },
      { passive: true }
    );

    document.querySelectorAll<HTMLElement>('.case-card').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        setMode('read');
        show();
      });
      el.addEventListener('mouseleave', hide);
    });

    document.querySelectorAll<HTMLElement>('.book__spine').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        if (el.closest('.book')?.classList.contains('book--open')) return;
        setMode('expand');
        show();
      });
      el.addEventListener('mouseleave', hide);
    });
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-24);
    padding-block: 0 var(--space-12);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* -------- Greeting + title capsule --------
     Block sized to the title svg's natural width (in em), centered in the hero.
     Greeting and title share the same left edge. */
  .hero__block {
    /* Drives em-based math for every descendant in this composition */
    font-size: clamp(3rem, 0.5rem + 11vw, 8rem);
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
    /* Top padding reserves room for the rectangles that overhang above the title */
    padding-top: 2.95em;
    text-align: left;
  }

  .hero__greeting {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.3125em; /* 40/128 */
    line-height: 1;
    color: var(--color-fg);
    margin: 0;
    max-width: none;
    padding: 0;
  }

  /* -------- Display title -------- */
  .hero-display {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1em;
    line-height: 1;
    color: var(--color-fg);
    margin: 0;
    margin-top: -0.08em;
  }

  /* Title container — sized to svg natural aspect in em */
  .hero-display__title {
    position: relative;
    display: block;
    /* 870 / 128 = 6.797em (svg title span width at base font-size) */
    width: 6.797em;
    max-width: 100%;
    aspect-ratio: 871 / 117;
  }

  /* Each hero-title wrapper stretches to fill the title container */
  .hero-title {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--color-fg);
  }

  .hero-title :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible; /* helmet extends slightly above viewBox corners */
  }

  /* Outlined instance — sits beneath solid and rectangles */
  .hero-title--outline {
    z-index: 3;
  }
  .hero-title--outline :global(.hero-title__letters path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linejoin: round;
  }

  /* Solid instance — on top, clipped so the right 30% reveals the outline beneath */
  .hero-title--solid {
    z-index: 4;
    clip-path: inset(0 30% 0 0);
  }

  /* Rectangles sit between outline (below) and solid (above), covering the right portion.
     Sizing is in % of title width so the composition scales uniformly as the svg scales. */
  .hero-display__rect {
    position: absolute;
    display: block;
    top: 0;
    width: 41.38%; /* 360/870 */
    aspect-ratio: 360 / 540;
    pointer-events: none;
  }

  /* White rect — aligned with the solid-title clip line (left edge at 70%). */
  .hero-display__rect--white {
    left: 70%;
    margin-top: -41.03%; /* -357/870 of title width */
    background: var(--color-bg);
    border: 2px solid var(--color-fg);
    z-index: 2;
  }

  /* Blue rect — offset down-and-right from the white rect. */
  .hero-display__rect--blue {
    left: calc(70% + 3.45%); /* +30/870 */
    margin-top: -37.59%; /* -327/870 of title width */
    background: var(--color-mark-blue);
    z-index: 1;
  }

  /* -------- Tagline -------- */
  .hero__tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1.25rem, 0.3rem + 2.5vw, 2.5rem);
    line-height: 1.4;
    text-align: center;
    color: var(--color-fg);
    max-width: none;
    margin: 0;
  }

  .hero__tagline b {
    font-weight: 500;
  }

  .hero__hsbc-mark {
    display: inline-block;
    line-height: 0;
    vertical-align: -0.08em;
    color: #db0011;
  }

  .hero__hsbc-mark :global(svg) {
    /* 32px at tagline's 40px base = 0.8em; HSBC wordmark aspect ≈ 63:32 */
    height: 1.5em;
    width: 1.5em;
    display: inline-block;
		vertical-align: text-bottom;
		margin: -0.05em;
  }

  /* ================= Professional work section ================= */
  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-12) 0;
  }

  /* Heading — serif display type, tie svg replaces the first 'i' */
  .work__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.5rem, 0.5rem + 7vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--color-fg);
    margin: 0;
  }

  .work__tie {
    display: inline-block;
    vertical-align: baseline;
    height: 0.85em;
    aspect-ratio: 51 / 102;
    margin-inline: 0.02em;
    color: var(--color-fg);
    translate: 0 0.1em; /* nudge down so tie knot aligns with x-height */
  }

  .work__tie :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .work__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .work__row { grid-template-columns: minmax(0, 1fr); }
  }

  /* -------- Case card (shared) -------- */
  .case-card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--color-fg);
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-base, 200ms) var(--ease-out, ease-out);
  }

  .case-card:focus-visible {
    outline: 3px solid var(--color-mark-blue);
    outline-offset: 4px;
  }

  .case-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: clamp(2rem, 2vw, 3rem);
  }

  .case-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.25rem, 0.8rem + 1vw, 2rem);
    line-height: 1.2;
    letter-spacing: 0.01em;
    margin: 0;
    color: var(--color-fg);
  }

  .case-card__desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg);
    margin: 0;
  }

  .case-card__media {
    background: #d9d9d9;
    flex: 1 1 auto;
    position: relative;
    overflow: hidden;
  }

  .case-card__media--top {
    aspect-ratio: 540 / 300;
    flex: none;
  }

  /* Per-card background colors */
  .case-card--hsbc .case-card__media { background: #CE3726; }
  .case-card--bale .case-card__media { background: #67A6C7; }
  .case-card--talbots .case-card__media { background: #5142C7; }

  /* Banner peeking from the bottom-right of the media area.
     Anchored past the bottom-right corner so the image's edges run off the
     bottom and right and only the upper-left portion stays visible. */
  .case-card__banner {
    position: absolute;
    right: -8%;
    bottom: -12%;
    width: 100%;
